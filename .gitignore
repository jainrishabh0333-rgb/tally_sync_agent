*.log
sync.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Sent orders — the exact XML sent to Tally and Tally's reply. Business data
# (party, GSTIN, rates, amounts) and this repo is public: keep them local.
sent_orders/
sent-*.xml
resp-*.xml

# Rate master — current trade rates for every item; business data, keep local
rates_master.json
masters_cache.json

# Raw voucher pull from live Tally — real parties, GSTINs, addresses, rates.
# Regenerate locally with fetch_order_sample.py; it must never be committed.
sample_orders.xml

# Rendered dispatch-readiness pages. They name parties, order numbers and
# shortfalls — internal only, and this repo is public. The renderer and its
# template are tracked; their output never is.
out/
